    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Vivid.Kernel.WebserviceExeInMemory</RootNamespace>
  </PropertyGroup>

  <!-- Private dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\ServiceCore\VividKernelServiceCore.csproj" />
