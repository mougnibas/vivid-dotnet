<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Base properties -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Vivid.Kernel.WebserviceExeInDatabaseInMemory</RootNamespace>
  </PropertyGroup>

  <!-- Private dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\DataAccessInDatabase\VividKernelDataAccessInDatabase.csproj" />
    <ProjectReference Include="..\ServiceCore\VividKernelServiceCore.csproj" />
    <ProjectReference Include="..\Webservice\VividKernelWebservice.csproj" />
  </ItemGroup>

  <!-- Public dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.8" />
  </ItemGroup>

  <!-- Publish options -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
