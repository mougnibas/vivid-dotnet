<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Base properties -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Vivid.Kernel.WebserviceExeInDatabaseMariadb</RootNamespace>
  </PropertyGroup>

  <!-- Private dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\ServiceCore\VividKernelServiceCore.csproj" />
    <ProjectReference Include="..\DataAccessInDatabase\VividKernelDataAccessInDatabase.csproj" />
    <ProjectReference Include="..\Webservice\VividKernelWebservice.csproj" />
  </ItemGroup>

  <!-- Public dependencies -->
  <ItemGroup>
    <PackageReference Include="Aspire.Pomelo.EntityFrameworkCore.MySql" Version="9.5.1" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>

  <!-- Publish options -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishProfile>DefaultContainer</PublishProfile>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <ContainerRepository>mougnibas/vivid-kernel-webservice-mariadb</ContainerRepository>
    <ContainerImageTag>1.0.0-snapshot</ContainerImageTag>
  </PropertyGroup>

</Project>
